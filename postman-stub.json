{
  "info": {
    "_postman_id": "finance-dashboard",
    "name": "Finance Dashboard API",
    "description": "Sample API requests for testing Categories with Sub-Categories and Transactions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register User (Auto-Creates Categories & Transactions)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"SecurePassword123!\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "Get All Categories (With Sub-Categories)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer YOUR_JWT_TOKEN"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/categories",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "categories"]
        }
      }
    },
    {
      "name": "Get All Transactions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer YOUR_JWT_TOKEN"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/transactions",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "transactions"]
        }
      }
    },
    {
      "name": "Create New Transaction",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer YOUR_JWT_TOKEN"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Grocery shopping at Coles\",\n  \"amount\": 125.75,\n  \"transactionDate\": \"2026-10-24\",\n  \"categoryId\": 2,\n  \"notes\": \"Weekly shopping for family\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/transactions",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "transactions"]
        }
      }
    },
    {
      "name": "Create New Sub-Category under Groceries",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer YOUR_JWT_TOKEN"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aldi\",\n  \"description\": \"Grocery shopping at Aldi\",\n  \"type\": \"EXPENSE\",\n  \"color\": \"#FFB3B3\",\n  \"parentCategoryId\": 1\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/categories",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "categories"]
        }
      }
    },
    {
      "name": "Create New Parent Category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer YOUR_JWT_TOKEN"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Entertainment\",\n  \"description\": \"Movies, games, and entertainment expenses\",\n  \"type\": \"EXPENSE\",\n  \"color\": \"#FF69B4\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/categories",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "categories"]
        }
      }
    }
  ]
}

